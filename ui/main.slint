export struct ServiceView {
    name: string,
    plan: string,
    message: string,
    kind: string,
    status: int,        // 0 waiting, 1 good, 2 degraded, 3 bad
    session: string,
    daily: string,
    weekly: string,
    monthly: string,
    session-pct: float, // -1 = n/a
    daily-pct: float,
    weekly-pct: float,
    monthly-pct: float,
    session-reset: string,
    daily-reset: string,
    weekly-reset: string,
    accent: color,
}

global Palette {
    out property <color> card: #111827;
    out property <color> tile: #ffffff0d;
    out property <color> text: #e5e7eb;
    out property <color> muted: #9ca3af;
    out property <color> good: #3ddc84;
    out property <color> warn: #ffb300;
    out property <color> bad: #ff5252;
    out property <color> idle: #6b7280;
    out property <color> brand: #26c8fe;
    out property <color> track: #ffffff14;
    out property <color> hairline: #ffffff1f;
    out property <color> grid: #ffffff12;

    public pure function status-color(s: int) -> color {
        return s == 1 ? self.good : s == 2 ? self.warn : s == 3 ? self.bad : self.idle;
    }
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <color> hover-color: #ffffff1f;
    callback clicked;

    width: 22px;
    height: 18px;
    border-radius: 4px;
    background: ta.has-hover ? hover-color : transparent;

    Path {
        width: 7px;
        height: 7px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.glyph;
        stroke: ta.has-hover ? white : Palette.text;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Compact percent + thin bar (table cell).
component PctCell inherits Rectangle {
    in property <string> value;
    in property <float> pct;
    in property <color> fill;
    in property <string> tip;
    width: 56px;
    height: 100%;
    background: transparent;

    VerticalLayout {
        spacing: 3px;
        width: 100%;
        alignment: center;

        Text {
            text: root.value;
            color: root.pct < 0 ? Palette.muted : root.fill;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Rectangle {
            height: 3px;
            border-radius: 1.5px;
            background: Palette.track;
            Rectangle {
                height: parent.height;
                width: root.pct < 0 ? 0px : parent.width * min(1, max(0, root.pct / 100));
                border-radius: 1.5px;
                background: root.fill;
            }
        }
    }

    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

component ServiceLogo inherits Image {
    in property <string> kind;
    width: 16px;
    height: 16px;
    source: kind == "claude" ? @image-url("../assets/logos/claude.png")
          : kind == "codex" ? @image-url("../assets/logos/codex.png")
          : kind == "grokbot" ? @image-url("../assets/logos/grokbot.png")
          : @image-url("../assets/logos/generic.png");
}

component ColHead inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    width: 56px;
    height: 100%;
    background: transparent;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: ta.has-hover && root.tip != "" ? Palette.brand : Palette.muted;
        font-size: 8px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: root.tip != "" ? help : default;
    }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

component ServiceRow inherits Rectangle {
    in property <ServiceView> s;
    // Good meters use Teknic brand cyan; warn/bad keep status colors.
    property <color> tone: s.message != "" ? Palette.bad
        : s.status == 0 ? Palette.idle
        : s.status == 1 ? Palette.brand
        : Palette.status-color(s.status);

    height: 36px;
    background: transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 0px;

        // Identity
        HorizontalLayout {
            width: 168px;
            spacing: 6px;
            alignment: start;

            ServiceLogo { kind: s.kind; y: 10px; }

            Text {
                text: s.name;
                color: Palette.text;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }

            if s.plan != "": Rectangle {
                height: 14px;
                y: 11px;
                border-radius: 3px;
                background: s.accent.with-alpha(0.22);
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text {
                        text: s.plan;
                        color: s.accent;
                        font-size: 8px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }
        }

        if s.message == "": HorizontalLayout {
            width: 176px; // 3x56 + 2x4 gaps - must match header metrics strip
            spacing: 4px;
            PctCell { value: s.session; pct: s.session-pct; fill: root.tone; tip: s.session-reset; }
            PctCell { value: s.daily; pct: s.daily-pct; fill: root.tone; tip: s.daily-reset; }
            PctCell { value: s.weekly; pct: s.weekly-pct; fill: root.tone; tip: s.weekly-reset; }
        }

        if s.message != "": Text {
            text: s.message;
            color: Palette.bad;
            font-size: 9px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    // Bottom hairline
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: parent.width;
        background: Palette.grid;
    }
}

export component MainWindow inherits Window {
    in property <[ServiceView]> services;
    in property <string> subtitle: "loading...";
    in property <string> status-text: "STARTING";
    in property <int> overall: 0;
    in property <string> session-tip;
    in property <string> daily-tip;
    in property <string> weekly-tip;
    in-out property <bool> on-top: true;
    in-out property <bool> locked: false;
    in-out property <bool> startup: false;

    callback drag(length, length);
    callback hide-clicked();
    callback quit-clicked();
    callback toggle-top();
    callback toggle-lock();
    callback toggle-startup();
    callback edit-config();
    callback reload-config();
    callback check-update();
    in property <string> version;

    no-frame: true;
    always-on-top: root.on-top;
    background: transparent;
    title: "AIUsageWidget";
    icon: @image-url("../assets/icon.png");
    width: 392px;

    Rectangle {
        background: Palette.card;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.hairline;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Header (drag)
            Rectangle {
                height: 28px;
                TouchArea {
                    mouse-cursor: root.locked ? default : move;
                    moved => {
                        if (!root.locked) {
                            root.drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    spacing: 6px;

                    Image {
                        source: @image-url("../assets/company-logo-header.png");
                        height: 14px;
                        width: 64px;
                        y: 7px;
                    }
                    Text {
                        text: "AI Usage";
                        color: Palette.brand;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: root.subtitle;
                        color: Palette.muted;
                        font-size: 8px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        height: 14px;
                        y: 7px;
                        border-radius: 7px;
                        background: Palette.status-color(root.overall).with-alpha(0.18);
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            Text {
                                text: root.status-text;
                                color: Palette.status-color(root.overall);
                                font-size: 8px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    IconButton {
                        y: 5px;
                        glyph: "M 1 1 L 9 9 M 9 1 L 1 9";
                        clicked => { root.hide-clicked(); }
                    }
                }
            }

            Rectangle { height: 1px; background: Palette.grid; }

            // Column headers (same 168 + 176 strip as ServiceRow)
            Rectangle {
                height: 22px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;
                    spacing: 0px;
                    Rectangle { width: 168px; }
                    HorizontalLayout {
                        width: 176px;
                        spacing: 4px;
                        ColHead { label: "SESSION"; tip: root.session-tip; }
                        ColHead { label: "DAILY"; tip: root.daily-tip; }
                        ColHead { label: "WEEKLY"; tip: root.weekly-tip; }
                    }
                }
            }

            Rectangle { height: 1px; background: Palette.grid; }

            for s in root.services: ServiceRow { s: s; }

            // Footer
            Rectangle {
                height: 18px;
                background: #0b1220;
                border-bottom-left-radius: 10px;
                border-bottom-right-radius: 10px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 5px;
                    Image {
                        source: @image-url("../assets/company-mark.png");
                        width: 10px;
                        height: 10px;
                        y: 4px;
                    }
                    Text {
                        text: "teknic.cc";
                        color: Palette.brand;
                        font-size: 8px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "v" + root.version;
                        color: Palette.muted;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        ContextMenuArea {
            Menu {
                MenuItem {
                    title: root.on-top ? "✓ Always on top" : "Always on top";
                    activated => { root.toggle-top(); }
                }
                MenuItem {
                    title: root.locked ? "✓ Lock position" : "Lock position";
                    activated => { root.toggle-lock(); }
                }
                MenuItem {
                    title: root.startup ? "✓ Start with Windows" : "Start with Windows";
                    activated => { root.toggle-startup(); }
                }
                MenuSeparator {}
                MenuItem {
                    title: "Edit config...";
                    activated => { root.edit-config(); }
                }
                MenuItem {
                    title: "Reload config";
                    activated => { root.reload-config(); }
                }
                MenuSeparator {}
                MenuItem {
                    title: "Check for updates (v" + root.version + ")";
                    activated => { root.check-update(); }
                }
                MenuSeparator {}
                MenuItem {
                    title: "Hide to tray";
                    activated => { root.hide-clicked(); }
                }
            }
        }
    }
}
